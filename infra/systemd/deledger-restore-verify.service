[Unit]
Description=Deledger isolated restore verification
After=docker.service deledger-backup.service
Requires=docker.service

[Service]
Type=oneshot
User=deledger-backup
Group=deledger-backup
SupplementaryGroups=docker
EnvironmentFile=/etc/deledger/backup.env
ExecStart=/home/admin/vault/deledger/infra/backup/restore-verify.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/mnt/deledger-backups
