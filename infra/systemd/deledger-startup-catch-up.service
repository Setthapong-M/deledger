[Unit]
Description=Deledger startup calendar catch-up
After=docker.service deledger.service
Requires=docker.service

[Service]
Type=oneshot
EnvironmentFile=/etc/deledger/runtime.env
ExecStart=/usr/bin/docker compose -f /home/admin/vault/deledger/infra/compose.yaml exec -T postgres psql --username postgres --dbname deledger --command SELECT\ public.catch_up_reporting_months\(\)
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
