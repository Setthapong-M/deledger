[Unit]
Description=Deledger encrypted PostgreSQL backup
After=deledger.service

[Service]
Type=oneshot
User=deledger-backup
Group=deledger-backup
EnvironmentFile=/etc/deledger/backup.env
ExecStart=/home/admin/vault/deledger/infra/backup/backup.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/mnt/deledger-backups
