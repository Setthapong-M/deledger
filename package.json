{
  "name": "deledger",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": "22.23.1"
  },
  "scripts": {
    "dev": "pnpm --dir web dev",
    "build": "pnpm --dir web build",
    "lint": "pnpm --dir web lint",
    "typecheck": "pnpm --dir web typecheck",
    "qc": "pnpm lint && pnpm typecheck",
    "db:migrate": "node-pg-migrate up -m db/migrations",
    "db:rollback": "node-pg-migrate down -m db/migrations",
    "test:db": "node scripts/test-db.mjs",
    "test:unit": "pnpm --dir web vitest run --project unit",
    "test:integration": "pnpm --dir web vitest run --project integration",
    "test:e2e": "pnpm --dir web playwright test",
    "test:ops": "pnpm --dir web vitest run --project operations",
    "test:coverage": "pnpm --dir web vitest run --coverage",
    "test:all": "pnpm test:unit && pnpm test:integration && pnpm test:e2e && pnpm test:ops && pnpm test:coverage",
    "operator:user": "node scripts/operator/user.mjs",
    "verify:release": "bash scripts/verify-release.sh"
  },
  "dependencies": {
    "node-pg-migrate": "9.0.0",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@types/node": "26.4.0",
    "@types/pg": "8.23.1"
  }
}
