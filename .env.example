APP_ORIGIN=http://deledger.internal
BUSINESS_TIME_ZONE=Asia/Bangkok
DATABASE_URL=postgresql://deledger_web:replace-me@postgres:5432/deledger
OPERATOR_DATABASE_URL=postgresql://deledger_operator:replace-me@postgres:5432/deledger
CLOUDFLARE_TEAM_DOMAIN=https://replace-me.cloudflareaccess.com
CLOUDFLARE_ACCESS_AUD=replace-me
CLOUDFLARE_TUNNEL_TOKEN=replace-me
BACKUP_AGE_RECIPIENT=age1replace-me
BACKUP_TARGET=/mnt/deledger-backups
DELEDGER_SECRET_DIR=/etc/deledger/secrets
DELEDGER_WEB_PASSWORD=replace-me
DELEDGER_MAINTENANCE_PASSWORD=replace-me
DELEDGER_OPERATOR_PASSWORD=replace-me
DELEDGER_EXPORT_KEY=base64-32-byte-key-placeholder
POSTGRES_DB=deledger
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-me
